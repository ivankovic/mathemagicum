{
  // The whole repository, not only what ships.
  //
  // `include` was `["src"]`, which typechecked the game and nothing else —
  // and the two things it left out are the two that drive it: three thousand
  // lines of browser scenarios in `e2e/`, and the build's own config. Both
  // are TypeScript, both are run by `bun`, and neither had ever been through
  // the compiler. `bun test` does not typecheck; biome lints without types.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun", "vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "e2e", "vite.config.ts"]
}
